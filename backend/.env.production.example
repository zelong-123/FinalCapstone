APP_NAME="Herald"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://herald.example.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=herald
DB_USERNAME=herald_app
DB_PASSWORD=CHANGE_TO_A_STRONG_SECRET

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=private
FRONTEND_URL=https://herald.example.com
CORS_ALLOWED_ORIGINS=https://herald.example.com

API_TOKEN_TTL_MINUTES=720
MAX_UPLOAD_KB=10240
FORECAST_DEFAULT_PERIODS=3
FORECAST_SAFETY_STOCK_PERCENT=15

BACKUP_DISK=local
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_BINARY=mysqldump
SEED_DEFAULT_PASSWORD=CHANGE_BEFORE_SEEDING
