APP_NAME="Herald"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Standard XAMPP MariaDB/phpMyAdmin defaults.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=RALD_2_0
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=private
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

API_TOKEN_TTL_MINUTES=1440
MAX_UPLOAD_KB=10240
FORECAST_DEFAULT_PERIODS=3
FORECAST_SAFETY_STOCK_PERCENT=15

BACKUP_DISK=local
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_BINARY=C:/xampp/mysql/bin/mysqldump.exe

# Change before any shared or production deployment.
SEED_DEFAULT_PASSWORD=Password123!
